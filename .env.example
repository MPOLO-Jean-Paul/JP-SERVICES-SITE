# ───────────── Application ─────────────
NODE_ENV=production
# Origine canonique HTTPS du site (liens d'e-mails, sitemap, SEO). Jamais déduite de l'en-tête Host.
APP_URL=https://jp-services.org
# Clé secrète longue et aléatoire (sessions, jetons signés). Générer : openssl rand -base64 48
APP_SECRET=remplacez-moi-par-une-valeur-aleatoire-longue
APP_TIMEZONE=Africa/Lubumbashi

# ───────────── Base de données PostgreSQL ─────────────
# Render Postgres, Neon ou Supabase. Ajouter ?sslmode=require pour une connexion externe.
DATABASE_URL=postgres://utilisateur:mot_de_passe@hote:5432/jpservices

# ───────────── E-mails transactionnels ─────────────
# Pour Render gratuit : utiliser l'API HTTPS Resend. Vérifier le domaine
# dans Resend avant d'activer les envois. Ne jamais enregistrer une clé ici.
RESEND_API_KEY=
# Alternative SMTP seulement pour les hébergements autorisant le port 587.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=contact@jp-services.org
SMTP_PASSWORD=mot-de-passe-d-application
SMTP_FROM_ADDRESS=contact@jp-services.org
SMTP_FROM_NAME=JP-Services
# Adresse qui reçoit les notifications internes (plannings, partenariats, contact)
ADMIN_NOTIFICATION_EMAIL=contact@jp-services.org

# ───────────── Connexion Google (facultatif) ─────────────
# ID client OAuth de type « Application Web » ; ajouter l'origine APP_URL dans les origines JavaScript autorisées.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_HOSTED_DOMAIN=

# ───────────── Stockage des fichiers téléversés ─────────────
# s3 : bucket compatible S3 — Neon Object Storage ou Cloudflare R2.
# Avec Render Free, le stockage local est temporaire et ne convient pas aux données réelles.
# local : dossier UPLOAD_DIR (par défaut ./uploads) — VPS / Docker avec volume.
STORAGE_DRIVER=s3
# Cloudflare R2 : https://<ID_COMPTE>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=jp-services-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
UPLOAD_DIR=

# ───────────── Référencement ─────────────
INDEXNOW_KEY=
GOOGLE_SITE_VERIFICATION=

# ───────────── Docker Compose uniquement ─────────────
DB_PASSWORD=
# Import depuis l’ancienne base MySQL (pnpm db:import-mysql), facultatif
MYSQL_URL=

# Création du premier administrateur au démarrage (à retirer ensuite)
ADMIN_EMAIL=
ADMIN_PASSWORD=
