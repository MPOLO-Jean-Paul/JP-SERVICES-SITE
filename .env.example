# ───────────── Application ─────────────
NODE_ENV=production
# Origine canonique HTTPS du site (liens d'e-mails, sitemap, SEO). Jamais déduite de l'en-tête Host.
APP_URL=https://jp-services.org
# Clé secrète longue et aléatoire (sessions, jetons signés). Générer : openssl rand -base64 48
APP_SECRET=remplacez-moi-par-une-valeur-aleatoire-longue
APP_TIMEZONE=Africa/Lubumbashi

# ───────────── Base de données MySQL / MariaDB (utf8mb4) ─────────────
DATABASE_URL=mysql://utilisateur:mot_de_passe@hote:3306/jpservices

# ───────────── E-mails transactionnels (SMTP) ─────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=contact@exemple.tld
SMTP_PASSWORD=mot-de-passe-d-application
SMTP_FROM_ADDRESS=contact@exemple.tld
SMTP_FROM_NAME=JP-Services
# Adresse qui reçoit les notifications internes (plannings, partenariats, contact)
ADMIN_NOTIFICATION_EMAIL=contact@exemple.tld

# ───────────── Connexion Google (facultatif) ─────────────
# ID client OAuth de type « Application Web » ; ajouter l'origine APP_URL dans les origines JavaScript autorisées.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_HOSTED_DOMAIN=

# ───────────── Stockage des fichiers téléversés ─────────────
# local : dossier public/uploads (VPS / Docker). s3 : bucket compatible S3 (Cloudflare R2, AWS S3, MinIO…) pour Vercel.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL publique du bucket (domaine R2 public ou CDN)
S3_PUBLIC_URL=

# ───────────── Référencement ─────────────
INDEXNOW_KEY=
GOOGLE_SITE_VERIFICATION=

# ───────────── Docker Compose uniquement ─────────────
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Création du premier administrateur au démarrage (à retirer ensuite)
ADMIN_EMAIL=
ADMIN_PASSWORD=
