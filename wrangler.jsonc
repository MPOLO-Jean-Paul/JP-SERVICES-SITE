{
  // Cloudflare Workers (OpenNext). Déployer : pnpm cf:deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jp-services",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Évite l’injection de « __name » dans les scripts sérialisés (next-themes).
  "keep_names": false,
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "jp-services" }],
  "observability": { "enabled": true },
  "limits": { "cpu_ms": 30000 },
  // Connexion PostgreSQL mutualisée par Cloudflare Hyperdrive.
  // Créer : npx wrangler hyperdrive create jp-services-db --connection-string="postgres://…"
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REMPLACER_PAR_ID_HYPERDRIVE",
      "localConnectionString": "postgres://jp:jp_dev_password@127.0.0.1:5432/jpservices"
    }
  ],
  "vars": {
    "APP_TIMEZONE": "Africa/Lubumbashi",
    "STORAGE_DRIVER": "s3",
    "S3_REGION": "auto",
    "S3_BUCKET": "jp-services-uploads",
    "SMTP_PORT": "587",
    "SMTP_FROM_NAME": "JP-Services"
  }
  // Secrets (npx wrangler secret put NOM) : APP_URL, APP_SECRET, DATABASE_URL (repli),
  // S3_ENDPOINT, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, SMTP_HOST, SMTP_USERNAME,
  // SMTP_PASSWORD, SMTP_FROM_ADDRESS, ADMIN_NOTIFICATION_EMAIL.
}
