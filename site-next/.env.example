# Ne jamais publier les secrets serveur.
# URL Render/Cloudflare propre à chaque déploiement ; utiliser l'URL officielle UNIQUEMENT après la bascule.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Identité officielle de JP-SERVICES : https://jp-services.org
CONTACT_EMAIL=contact@jp-services.org

# Configurer uniquement quand une base Neon durable a été créée et les migrations exécutées.
DATABASE_URL=
CONTACT_RATE_LIMIT_SALT=
# Générer ces valeurs localement avec : node scripts/generate-admin-credentials.mjs admin
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
